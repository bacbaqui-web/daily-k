{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rolling humor public state v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "mode": {
      "const": "rolling-humor"
    },
    "timezone": {
      "const": "Asia/Seoul"
    },
    "retentionHours": {
      "const": 24
    },
    "minimumLiteralK": {
      "const": 10
    },
    "updatedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|[+-]\\d{2}:\\d{2})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "lastCheck": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "ok",
                "empty",
                "partial",
                "blocked",
                "challenge",
                "failed",
                "stopped"
              ]
            },
            "checkedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "(Z|[+-]\\d{2}:\\d{2})$"
            },
            "note": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1200
            },
            "count": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          },
          "required": [
            "status",
            "checkedAt",
            "note",
            "count"
          ],
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^aagag-[0-9]+$"
          },
          "canonicalUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "(Z|[+-]\\d{2}:\\d{2})$"
          },
          "firstObservedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "(Z|[+-]\\d{2}:\\d{2})$"
          },
          "lastVerifiedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "(Z|[+-]\\d{2}:\\d{2})$"
          },
          "publicationEvidence": {
            "type": "object",
            "properties": {
              "method": {
                "enum": [
                  "aagag-otime",
                  "aagag-explicit-publication"
                ]
              },
              "sourceUrl": {
                "type": "string",
                "format": "uri",
                "pattern": "^https?://"
              },
              "value": {
                "type": "string",
                "format": "date-time",
                "pattern": "(Z|[+-]\\d{2}:\\d{2})$"
              },
              "raw": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "observedAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "(Z|[+-]\\d{2}:\\d{2})$"
              },
              "semanticsVerified": {
                "const": true
              }
            },
            "required": [
              "method",
              "sourceUrl",
              "value",
              "raw",
              "observedAt",
              "semanticsVerified"
            ],
            "additionalProperties": false
          },
          "review": {
            "type": "object",
            "properties": {
              "safetyChecked": {
                "const": true
              },
              "rightsChecked": {
                "const": true
              },
              "verifiedAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "(Z|[+-]\\d{2}:\\d{2})$"
              },
              "note": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200
              }
            },
            "required": [
              "safetyChecked",
              "rightsChecked",
              "verifiedAt",
              "note"
            ],
            "additionalProperties": false
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https?://"
                },
                "verifiedAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "(Z|[+-]\\d{2}:\\d{2})$"
                },
                "publishedAt": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "(Z|[+-]\\d{2}:\\d{2})$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "quotes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "name",
                "title",
                "url",
                "verifiedAt",
                "publishedAt"
              ],
              "additionalProperties": false
            }
          },
          "content": {
            "type": "object",
            "properties": {
              "imageUrl": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https?://"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "videoUrl": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https?://"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "videoPosterUrl": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https?://"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "bodyImages": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "format": "uri",
                      "pattern": "^https?://"
                    },
                    "width": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "height": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "url",
                    "width",
                    "height"
                  ],
                  "additionalProperties": false
                }
              },
              "bodyImagesSourceUrl": {
                "type": "string",
                "format": "uri",
                "pattern": "^https?://"
              },
              "bodyImagesVerifiedAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "(Z|[+-]\\d{2}:\\d{2})$"
              },
              "originalText": {
                "type": "string",
                "maxLength": 1000
              },
              "comments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    }
                  },
                  "required": [
                    "id",
                    "text"
                  ],
                  "additionalProperties": false
                }
              },
              "portalLinks": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https?://"
                }
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "limitations": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "(Z|[+-]\\d{2}:\\d{2})$"
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "(Z|[+-]\\d{2}:\\d{2})$"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "kCount": {
            "type": "integer",
            "minimum": 10
          },
          "commentCount": {
            "type": "integer",
            "minimum": 1
          },
          "commentsVerifiedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "(Z|[+-]\\d{2}:\\d{2})$"
          },
          "nativeEvidenceSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "canonicalUrl",
          "title",
          "publishedAt",
          "firstObservedAt",
          "lastVerifiedAt",
          "publicationEvidence",
          "review",
          "sources",
          "content",
          "limitations",
          "expiresAt",
          "recordedAt",
          "revision",
          "kCount",
          "commentCount",
          "commentsVerifiedAt",
          "nativeEvidenceSha256"
        ],
        "additionalProperties": false
      }
    },
    "registry": {
      "type": "object"
    },
    "operations": {
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "mode",
    "timezone",
    "retentionHours",
    "minimumLiteralK",
    "updatedAt",
    "lastCheck",
    "items",
    "registry",
    "operations"
  ],
  "additionalProperties": false
}
