{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Daily K verified live batch v1",
  "description": "Upsert input. CLI also checks actual times, 25-word quotations, source scope, stable identity and optimistic revision. This structural schema does not replace editorial verification.",
  "type": "object",
  "required": [
    "schemaVersion",
    "operationId",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "operationId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,119}$"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "publishedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "verifiedAt": {
          "type": "string",
          "format": "date-time"
        },
        "platform": {
          "enum": [
            "aagag",
            "community",
            "dcinside",
            "instagram",
            "x",
            "other"
          ]
        },
        "region": {
          "enum": [
            "KR",
            "unknown"
          ]
        },
        "regionEvidenceUrl": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://"
            },
            {
              "type": "null"
            }
          ]
        },
        "periodStart": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "periodEnd": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "limitations": {
          "type": "string",
          "minLength": 1
        },
        "quotes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "name",
        "title",
        "url",
        "publishedAt",
        "verifiedAt",
        "platform",
        "region",
        "limitations"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "region": {
                "const": "KR"
              }
            }
          },
          "then": {
            "required": [
              "regionEvidenceUrl"
            ],
            "properties": {
              "regionEvidenceUrl": {
                "type": "string",
                "format": "uri",
                "pattern": "^https?://"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "platform": {
                "const": "instagram"
              }
            }
          },
          "then": {
            "properties": {
              "region": {
                "const": "unknown"
              }
            }
          }
        }
      ]
    },
    "observation": {
      "type": "object",
      "properties": {
        "sourceUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "sourceUrl",
        "metric",
        "value",
        "unit",
        "observedAt",
        "scope"
      ]
    },
    "item": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,119}$"
        },
        "kind": {
          "enum": [
            "topic",
            "community"
          ]
        },
        "topicKey": {
          "type": "string",
          "minLength": 1
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "maxLength": 1200
        },
        "firstObservedAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastVerifiedAt": {
          "type": "string",
          "format": "date-time"
        },
        "canonicalUrl": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://"
            },
            {
              "type": "null"
            }
          ]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observation"
          }
        },
        "limitations": {
          "type": "string",
          "minLength": 1
        },
        "selectionReason": {
          "type": "string",
          "minLength": 1
        },
        "safetyChecked": {
          "const": true
        },
        "rightsChecked": {
          "const": true
        },
        "content": {
          "type": "object",
          "description": "Existing community schema v2 story; full semantic/media validation in scripts/live/manage.py."
        }
      },
      "required": [
        "id",
        "kind",
        "topicKey",
        "expectedRevision",
        "title",
        "summary",
        "firstObservedAt",
        "lastVerifiedAt",
        "canonicalUrl",
        "sources",
        "observations",
        "limitations",
        "selectionReason",
        "safetyChecked",
        "rightsChecked"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "community"
              }
            }
          },
          "then": {
            "required": [
              "content"
            ],
            "properties": {
              "summary": {
                "const": ""
              },
              "canonicalUrl": {
                "type": "string",
                "format": "uri",
                "pattern": "^https?://"
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "content"
              ]
            }
          }
        }
      ]
    }
  }
}
